digraph "weak_reference_demo" {
  rankdir=LR;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "actor:example:weak_reference_demo:weak_reference_demo::PingActor" [label="{weak_reference_demo::PingActor|GetStatus -\> Status\lPing -\> String\l}"];
  "external" [shape=ellipse, style=dashed, label="external (main)"];
  "external" -> "actor:example:weak_reference_demo:weak_reference_demo::PingActor" [style="bold", label="spawn"];
  "external" -> "actor:example:weak_reference_demo:weak_reference_demo::PingActor" [label="ask GetStatus -> Status\nask Ping -> String"];
}
