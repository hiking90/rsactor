digraph "dining_philosophers" {
  rankdir=LR;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "example:dining_philosophers:dining_philosophers::Philosopher" [label="{dining_philosophers::Philosopher|StartEating\lStartThinking\l}"];
  "example:dining_philosophers:dining_philosophers::Table" [label="{dining_philosophers::Table|RegisterPhilosopher\lReleaseFork\lRequestFork -\> bool\l}"];
}
