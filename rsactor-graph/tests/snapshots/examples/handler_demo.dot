digraph "handler_demo" {
  rankdir=LR;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "actor:example:handler_demo:handler_demo::CounterActor" [label="{handler_demo::CounterActor|GetStatus -\> Status\lPing\l}"];
  "actor:example:handler_demo:handler_demo::LoggerActor" [label="{handler_demo::LoggerActor|GetStatus -\> Status\lPing\l}"];
  "external" [shape=ellipse, style=dashed, label="external (main)"];
  "external" -> "actor:example:handler_demo:handler_demo::CounterActor" [style="bold", label="spawn"];
  "external" -> "actor:example:handler_demo:handler_demo::LoggerActor" [style="bold", label="spawn"];
}
