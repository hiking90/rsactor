digraph "tracing_demo" {
  rankdir=LR;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "actor:example:tracing_demo:tracing_demo::TracingDemoActor" [label="{tracing_demo::TracingDemoActor|Echo -\> String\lFailingMessage -\> Result\<String, String\>\lGetCounter -\> u64\lIncrement -\> String\lPing -\> String\lSlowOperation -\> String\l}"];
  "external" [shape=ellipse, style=dashed, label="external (main)"];
  "external" -> "actor:example:tracing_demo:tracing_demo::TracingDemoActor" [style="bold", label="spawn"];
  "external" -> "actor:example:tracing_demo:tracing_demo::TracingDemoActor" [label="tell_with_timeout Increment -> String"];
  "external" -> "actor:example:tracing_demo:tracing_demo::TracingDemoActor" [label="ask Echo -> String\nask FailingMessage -> Result<String, String>\nask GetCounter -> u64\nask Increment -> String\nask Ping -> String\nask SlowOperation -> String\nask_with_timeout SlowOperation -> String"];
}
