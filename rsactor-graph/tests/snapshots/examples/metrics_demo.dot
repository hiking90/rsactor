digraph "metrics_demo" {
  rankdir=LR;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "actor:example:metrics_demo:metrics_demo::WorkerActor" [label="{metrics_demo::WorkerActor|FastTask\lGetName -\> String\lSlowTask\l}"];
  "external" [shape=ellipse, style=dashed, label="external (main)"];
  "external" -> "actor:example:metrics_demo:metrics_demo::WorkerActor" [style="bold", label="spawn"];
}
