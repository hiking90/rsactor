digraph "actor_async_worker" {
  rankdir=LR;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "actor:example:actor_async_worker:actor_async_worker::RequesterActor" [label="{actor_async_worker::RequesterActor|GetResults -\> Vec\<String\>\lRequestWork\lWorkCompleted\l}"];
  "actor:example:actor_async_worker:actor_async_worker::WorkerActor" [label="{actor_async_worker::WorkerActor|ProcessTask\l}"];
  "external" [shape=ellipse, style=dashed, label="external (main)"];
  "actor:example:actor_async_worker:actor_async_worker::RequesterActor" -> "actor:example:actor_async_worker:actor_async_worker::WorkerActor" [style="dotted", color=gray50];
  "external" -> "actor:example:actor_async_worker:actor_async_worker::RequesterActor" [style="bold", label="spawn"];
  "external" -> "actor:example:actor_async_worker:actor_async_worker::WorkerActor" [style="bold", label="spawn"];
}
