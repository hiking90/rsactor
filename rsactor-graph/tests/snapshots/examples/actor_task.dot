digraph "actor_task" {
  rankdir=LR;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "example:actor_task:actor_task::DataProcessorActor" [label="{actor_task::DataProcessorActor|GetState -\> (f64, Option\<f64\>, Option\<Instant\>)\lProcessedData\lSendTaskCommand -\> bool\lSetFactor -\> f64\l}"];
}
