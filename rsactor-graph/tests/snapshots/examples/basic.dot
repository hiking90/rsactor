digraph "basic" {
  rankdir=LR;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "actor:example:basic:basic::MyActor" [label="{basic::MyActor|Decrement -\> u32\lDummyMessage -\> u32\lIncrement -\> u32\l}"];
  "external" [shape=ellipse, style=dashed, label="external (main)"];
  "external" -> "actor:example:basic:basic::MyActor" [style="bold", label="spawn (spawn_with_options)"];
}
