digraph "unified_macro_demo" {
  rankdir=LR;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "example:unified_macro_demo:unified_macro_demo::GenericActor" [label="{unified_macro_demo::GenericActor\<T\>|GetValue -\> Option\<T\>\lSetValue\<T\>\l}"];
  "example:unified_macro_demo:unified_macro_demo::SimpleActor" [label="{unified_macro_demo::SimpleActor|GetCount -\> i32\lIncrement\l}"];
}
